# Copy to .env locally — never commit .env

DATABASE_URL=postgresql://USER:PASS@HOST/DATABASE
REDIS_URL=redis://default:TOKEN@HOST:6379

SECRET_KEY=change-me-long-random-string
GROQ_API_KEY=gsk_...

FRONTEND_URL=http://localhost:5173
CORS_EXTRA_ORIGINS=https://pfe-recrutement-ia.vercel.app
DEBUG=true

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

OCR_LANG=latin
INTERVIEW_TESTING_MODE=false

# Optional — default to REDIS_URL if omitted
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
