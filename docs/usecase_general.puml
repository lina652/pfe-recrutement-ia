@startuml usecase_general
' General Use Case Diagram — TalentOs
' <<include>>  = mandatory sub-behavior (always performed)
' <<extend>>   = optional / conditional extension
' Render: PlantUML (VS Code extension, plantuml.com, or IntelliJ)

left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 24
skinparam ranksep 40
skinparam padding 8
skinparam defaultFontSize 12
skinparam titleFontSize 15
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam package {
  BackgroundColor #F8F9FA
  BorderColor #666666
}

title General Use Case Diagram\nTalentOs — AI-Powered Recruitment Platform

' ═══════════════════════════════════════════════════════════
' ACTORS
' ═══════════════════════════════════════════════════════════
actor "Candidate" as cand
actor "Recruiter" as rec
actor "Hiring Manager" as hm
actor "Administrator" as adm
actor "Super Administrator" as sa
actor "AI System" as ai

cand -[hidden]down- rec
rec  -[hidden]down- hm
hm   -[hidden]down- adm
adm  -[hidden]down- sa

' ═══════════════════════════════════════════════════════════
' SYSTEM BOUNDARY
' ═══════════════════════════════════════════════════════════
rectangle "TalentOs Recruitment System" {

  package "Security" as PKG_SEC {
    usecase "Authenticate\n(Login / JWT)" as UC_AUTH
  }

  package "Public & Onboarding" as PKG_PUB {
    usecase "Register Organization\n(OTP)" as UC_REG_ORG
    usecase "Browse Job Offers" as UC_BROWSE
  }

  package "Candidate" as PKG_CAND {
    usecase "Sign Up with CV\n(OCR + NER)" as UC_SIGNUP_CV
    usecase "Apply to Job Offer" as UC_APPLY
    usecase "Track Applications\n& Interviews" as UC_TRACK
    usecase "Schedule Interview\n(Time Slot)" as UC_SCHED
    usecase "Attend AI Interview" as UC_INTERVIEW
    usecase "View Evaluation Results" as UC_RESULTS
  }

  package "Recruitment" as PKG_REC {
    usecase "Submit Job Requirement" as UC_NEED
    usecase "Review & Publish Job" as UC_PUBLISH
    usecase "Manage Job Offers\n& Applications" as UC_PIPELINE
    usecase "Consult Hiring Assistant\n(RAG)" as UC_RAG
    usecase "Make Final Hiring Decision" as UC_DECIDE
  }

  package "Administration" as PKG_ADM {
    usecase "Invite & Manage Staff" as UC_STAFF
    usecase "Manage Users & Roles" as UC_USERS
    usecase "View Audit Logs & Reports" as UC_LOGS
  }

  package "Platform" as PKG_SA {
    usecase "Manage Tenant Companies" as UC_TENANTS
    usecase "Monitor Platform Health" as UC_MONITOR
  }

  package "AI Services" as PKG_AI #E8F4FD {
    usecase "Extract CV Text\n(OCR)" as UC_OCR
    usecase "Parse CV to JSON\n(NER / LLM)" as UC_NER
    usecase "Match CV to Job\n(Semantic)" as UC_MATCH
    usecase "Run Recruitment Workflow\n(LangGraph)" as UC_ORCH
    usecase "Generate Interview Report" as UC_REPORT
    usecase "Retrieve Context\n(RAG)" as UC_RETRIEVE
  }
}

' ═══════════════════════════════════════════════════════════
' ACTOR → USE CASE (primary associations)
' ═══════════════════════════════════════════════════════════
cand --> UC_BROWSE
cand --> UC_SIGNUP_CV
cand --> UC_APPLY
cand --> UC_TRACK
cand --> UC_SCHED
cand --> UC_INTERVIEW
cand --> UC_RESULTS

hm --> UC_NEED
hm --> UC_DECIDE
hm --> UC_RAG

rec --> UC_PUBLISH
rec --> UC_PIPELINE
rec --> UC_RAG

adm --> UC_REG_ORG
note bottom of UC_REG_ORG
  Public **/company/signup**
  (OTP); first company admin
end note
adm --> UC_STAFF
adm --> UC_USERS
adm --> UC_LOGS

sa --> UC_TENANTS
sa --> UC_MONITOR

ai --> UC_OCR
ai --> UC_NER
ai --> UC_MATCH
ai --> UC_ORCH
ai --> UC_REPORT
ai --> UC_RETRIEVE

' ═══════════════════════════════════════════════════════════
' <<include>> — mandatory (base ..> included)
' ═══════════════════════════════════════════════════════════

' --- Security: all protected operations include Authenticate ---
UC_SIGNUP_CV ..> UC_AUTH : <<include>>
UC_APPLY     ..> UC_AUTH : <<include>>
UC_TRACK     ..> UC_AUTH : <<include>>
UC_SCHED     ..> UC_AUTH : <<include>>
UC_INTERVIEW ..> UC_AUTH : <<include>>
UC_RESULTS   ..> UC_AUTH : <<include>>

UC_NEED      ..> UC_AUTH : <<include>>
UC_PUBLISH   ..> UC_AUTH : <<include>>
UC_PIPELINE  ..> UC_AUTH : <<include>>
UC_RAG       ..> UC_AUTH : <<include>>
UC_DECIDE    ..> UC_AUTH : <<include>>

UC_STAFF     ..> UC_AUTH : <<include>>
UC_USERS     ..> UC_AUTH : <<include>>
UC_LOGS      ..> UC_AUTH : <<include>>
UC_TENANTS   ..> UC_AUTH : <<include>>
UC_MONITOR   ..> UC_AUTH : <<include>>

' --- CV pipeline (always when processing a CV) ---
UC_SIGNUP_CV ..> UC_OCR  : <<include>>
UC_OCR       ..> UC_NER  : <<include>>
UC_APPLY     ..> UC_OCR  : <<include>>
UC_APPLY     ..> UC_NER  : <<include>>
UC_APPLY     ..> UC_MATCH : <<include>>

' --- Matching & workflow ---
UC_PIPELINE  ..> UC_MATCH : <<include>>
UC_ORCH      ..> UC_MATCH : <<include>>
UC_PUBLISH   ..> UC_ORCH  : <<include>>\n(on closing)

' --- Interview & RAG ---
UC_INTERVIEW ..> UC_REPORT   : <<include>>\n(on completion)
UC_RAG       ..> UC_RETRIEVE : <<include>>
UC_RETRIEVE  ..> UC_MATCH    : <<include>>\n(context build)

' ═══════════════════════════════════════════════════════════
' <<extend>> — optional (extension <.. base)
' UML: extension point on base; extension runs only if condition holds
' ═══════════════════════════════════════════════════════════

UC_SCHED     <.. UC_INTERVIEW : <<extend>>\nif invited &\nno slot yet

UC_DECIDE    <.. UC_PIPELINE  : <<extend>>\nif shortlist complete

UC_PUBLISH   <.. UC_NEED      : <<extend>>\nwhen requirement\naccepted

UC_SIGNUP_CV <.. UC_APPLY     : <<extend>>\nif guest applies\nwithout account

UC_REPORT    <.. UC_DECIDE    : <<extend>>\nif interview\ndone

UC_ORCH      <.. UC_PIPELINE  : <<extend>>\nif job closing\ndate reached

note right of ai
  **AI System** (external)
  • PaddleOCR + Groq LLM (CV)
  • Sentence Transformers (matching)
  • Groq Whisper + DeepFace (interview)
  • Chroma + LangGraph (RAG / workflow)
end note

legend right
  |= Relation |= Meaning |
  | Base → Included | <<include>> Always executed |
  | Extension → Base | <<extend>> Optional / conditional |
endlegend

@enduml
